generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  BOB_TRANSFER
  PAY_AT_PICKUP
  CASH_COUNTER
}

enum QuotationStatus {
  DRAFT
  SENT
  CONVERTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?  @unique
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @default("")
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      String[]         @default([])
  featured    Boolean          @default(false)
  demo        Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id          String                @id @default(cuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String                @unique
  barcode     String?               @unique
  size        String?
  color       String?
  price       Decimal               @db.Decimal(12, 2)
  gstRate     Decimal               @default(18) @db.Decimal(5, 2)
  active      Boolean               @default(true)
  inventories Inventory[]
  adjustments InventoryAdjustment[]
  orderItems  OrderItem[]
  quoteItems  QuotationItem[]
}

model Location {
  id          String                @id @default(cuid())
  name        String                @unique
  inventories Inventory[]
  adjustments InventoryAdjustment[]
}

model Inventory {
  id                 String        @id @default(cuid())
  variantId          String
  locationId         String
  quantity           Int           @default(0)
  lowStockThreshold  Int           @default(2)
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location           Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([variantId, locationId])
}

model InventoryAdjustment {
  id         String         @id @default(cuid())
  variantId  String
  locationId String
  delta      Int
  reason     String
  createdAt  DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  email         String?
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod
  deliveryType  String        @default("PICKUP")
  address       String?
  subtotal      Decimal       @db.Decimal(12, 2)
  taxTotal      Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String
  variantLabel    String
  sku             String
  quantity        Int
  shopQuantity    Int            @default(0)
  godownQuantity  Int            @default(0)
  unitPrice       Decimal        @db.Decimal(12, 2)
  gstRate         Decimal        @db.Decimal(5, 2)
  lineTotal       Decimal        @db.Decimal(12, 2)
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  reference  String?
  paidAt     DateTime      @default(now())
}

model School {
  id            String                @id @default(cuid())
  name          String
  contactPerson String
  phone         String
  address       String                @default("")
  createdAt     DateTime              @default(now())
  quotations    Quotation[]
  orders        InstitutionalOrder[]
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  status      QuotationStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  sentAt      DateTime?
  items       QuotationItem[]
  order       InstitutionalOrder?
}

model QuotationItem {
  id           String          @id @default(cuid())
  quotationId  String
  quotation    Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantLabel String
  sku          String
  quantity     Int
  quotedPrice  Decimal         @db.Decimal(12, 2)
  gstRate      Decimal         @db.Decimal(5, 2)
}

model InstitutionalOrder {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  quotationId    String        @unique
  quotation      Quotation     @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  invoiceNumber  String        @unique
  totalAmount    Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  orderDate      DateTime      @default(now())
  paymentDueDate DateTime
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime?
  items          InstitutionalOrderItem[]
  payments       InstitutionalPayment[]
}

model InstitutionalPayment {
  id                    String             @id @default(cuid())
  institutionalOrderId  String
  institutionalOrder    InstitutionalOrder @relation(fields: [institutionalOrderId], references: [id], onDelete: Cascade)
  method                PaymentMethod
  amount                Decimal            @db.Decimal(12, 2)
  reference             String?
  paidAt                DateTime           @default(now())
}

model InstitutionalOrderItem {
  id                    String             @id @default(cuid())
  institutionalOrderId  String
  institutionalOrder    InstitutionalOrder @relation(fields: [institutionalOrderId], references: [id], onDelete: Cascade)
  productName           String
  variantLabel          String
  sku                   String
  quantity              Int
  shopQuantity          Int                @default(0)
  godownQuantity        Int                @default(0)
  unitPrice             Decimal            @db.Decimal(12, 2)
  gstRate               Decimal            @db.Decimal(5, 2)
  lineTotal             Decimal            @db.Decimal(12, 2)
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}
